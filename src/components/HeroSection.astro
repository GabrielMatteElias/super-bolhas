---
import styles from './HeroSection.module.css';
import { siteContent } from '../data/siteContent';
import heroImage from '../assets/hero.webp';
const [headlineLead, headlineAccent] = siteContent.hero.title.split(' e ');
---
<section class={styles.hero} id="inicio" aria-labelledby="hero-title">
  <div class:list={['container', styles.grid]}>
    <div class={styles.copy}>
      <p class="section-kicker">{siteContent.hero.eyebrow}</p>
      <h1 id="hero-title">{headlineLead} <span>{headlineAccent && `e ${headlineAccent}`}</span></h1>
      <p class={styles.description}>{siteContent.hero.description}</p>
      <div class={styles.actions}>
        <a class="button" href="#receita">Vamos preparar! <span aria-hidden="true">↓</span></a>
        <a class={styles.secondary} href="#dicas">Quero aprender a brincar <span aria-hidden="true">↗</span></a>
      </div>
      <p class={styles.quick}>3 ingredientes <span aria-hidden="true">·</span> 4 passos <span aria-hidden="true">·</span> diversão em família</p>
    </div>
    <div class={styles.art} aria-hidden="true">
      <img class={styles.heroImage} src={heroImage.src} alt="" fetchpriority="high" decoding="async" />
      <span class={styles.caption}>Plim! Plim! Olha uma bolha!</span>
    </div>
  </div>
</section>
