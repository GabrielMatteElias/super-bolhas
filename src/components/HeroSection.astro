---
import styles from './HeroSection.module.css';
import { siteContent } from '../data/siteContent';
const [headlineLead, headlineAccent] = siteContent.hero.title.split(' e ');
---
<section class={styles.hero} id="inicio" aria-labelledby="hero-title">
  <div class:list={['container', styles.grid]}>
    <div class={styles.copy}>
      <p class="section-kicker">{siteContent.hero.eyebrow}</p>
      <h1 id="hero-title">{headlineLead} <span>{headlineAccent && `e ${headlineAccent}`}</span></h1>
      <p class={styles.description}>{siteContent.hero.description}</p>
      <div class={styles.actions}>
        <a class="button" href="#receita">Vamos preparar! <span aria-hidden="true">↓</span></a>
        <a class={styles.secondary} href="#dicas">Quero aprender a brincar <span aria-hidden="true">↗</span></a>
      </div>
      <p class={styles.quick}>3 ingredientes <span aria-hidden="true">·</span> 4 passos <span aria-hidden="true">·</span> diversão em família</p>
    </div>
    <div class={styles.art} aria-hidden="true">
      <svg class={styles.wand} viewBox="0 0 460 390" fill="none">
        <path d="M130 310 284 147" stroke="#1456C0" stroke-width="19" stroke-linecap="round"/>
        <path d="M111 330c-10 8-20 7-24 0-4-8 3-19 14-30l39-39" stroke="#FFD93D" stroke-width="13" stroke-linecap="round"/>
        <path d="M130 310 284 147" stroke="#79DEFF" stroke-width="5" stroke-linecap="round"/>
        <circle cx="305" cy="125" r="100" fill="url(#bigBubble)" fill-opacity=".72" stroke="white" stroke-width="7"/>
        <circle cx="305" cy="125" r="86" stroke="#FFB5E0" stroke-opacity=".9" stroke-width="4"/>
        <path d="M246 107c13-35 41-55 72-52M329 59l16 11" stroke="white" stroke-width="12" stroke-linecap="round"/>
        <path d="M264 184c28 20 56 22 81 8" stroke="#8DEEFF" stroke-width="7" stroke-linecap="round"/>
        <circle cx="133" cy="104" r="43" fill="url(#smallBubble)" fill-opacity=".82" stroke="white" stroke-width="4"/>
        <path d="M109 95c7-16 20-25 35-25" stroke="white" stroke-width="6" stroke-linecap="round"/>
        <circle cx="390" cy="246" r="33" fill="url(#smallBubble)" fill-opacity=".84" stroke="white" stroke-width="4"/>
        <path d="M372 238c5-12 14-18 25-19" stroke="white" stroke-width="5" stroke-linecap="round"/>
        <path d="m180 45 7 18 18 7-18 7-7 18-7-18-18-7 18-7 7-18Zm206 6 5 12 12 5-12 5-5 12-5-12-12-5 12-5 5-12ZM71 196l5 12 12 5-12 5-5 12-5-12-12-5 12-5 5-12Z" fill="#FFD93D" stroke="#183153" stroke-width="2" stroke-linejoin="round"/>
        <circle cx="88" cy="78" r="5" fill="#FF70B7"/><circle cx="420" cy="164" r="6" fill="#7BE7B5"/><circle cx="218" cy="287" r="5" fill="#FF9F43"/>
        <defs>
          <radialGradient id="bigBubble" cx="0" cy="0" r="1" gradientTransform="matrix(109 90 -90 109 263 70)" gradientUnits="userSpaceOnUse"><stop stop-color="white" stop-opacity=".98"/><stop offset=".32" stop-color="#A8F4FF" stop-opacity=".72"/><stop offset=".62" stop-color="#FFB6E2" stop-opacity=".63"/><stop offset=".82" stop-color="#C8B8FF" stop-opacity=".73"/><stop offset="1" stop-color="#8DEEFF" stop-opacity=".45"/></radialGradient>
          <linearGradient id="smallBubble" x1="103" y1="65" x2="168" y2="148" gradientUnits="userSpaceOnUse"><stop stop-color="white" stop-opacity=".9"/><stop offset=".45" stop-color="#90F0FF" stop-opacity=".62"/><stop offset="1" stop-color="#FF9BCB" stop-opacity=".78"/></linearGradient>
        </defs>
      </svg>
      <span class={styles.caption}>Plim! Plim! Olha uma bolha!</span>
    </div>
  </div>
</section>
